# Dubla Aí — variáveis de ambiente
#
# Copie para .env.local. NUNCA versione segredos (§90).
# As variáveis são validadas no boot por packages/shared/src/env.ts:
# a aplicação recusa iniciar com configuração inválida em vez de falhar
# no meio de uma gravação.

# ---------------------------------------------------------------------------
# Cliente (expostas ao navegador — nada sensível aqui)
# ---------------------------------------------------------------------------

# URL pública da aplicação. Usada em metadata/OpenGraph (§85).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prefixo de onde a mídia das cenas é servida.
# Fases 0-4: estático local. Fase 5: CDN / object storage.
NEXT_PUBLIC_MEDIA_BASE_URL=/media

# ---------------------------------------------------------------------------
# Fases 5+ — ainda não usadas. Deixadas documentadas, não configuradas.
# ---------------------------------------------------------------------------

# DATABASE_URL=postgresql://user:password@localhost:5432/dublaai
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# REDIS_URL=
